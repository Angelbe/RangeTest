"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import type { KeyboardEvent, PointerEvent } from "react";

type RangeSide = "minimum" | "maximum";
type RangeValues = [number, number];

type RangeProps =
  | {
      mode: "normal";
      min: number;
      max: number;
      initialValues?: RangeValues;
      label?: string;
    }
  | {
      mode: "fixed";
      values: number[];
      initialValues?: RangeValues;
      label?: string;
    };

function formatValue(value: number) {
  return String(Number(value.toFixed(2)));
}

export default function Range(props: RangeProps) {
  const { mode, initialValues, label = "Price range" } = props;
  const fixedValues = mode === "fixed" ? props.values : undefined;
  const options = useMemo(
    () => (fixedValues ? [...fixedValues].sort((a, b) => a - b) : []),
    [fixedValues],
  );
  const domainMin = mode === "normal" ? props.min : options?.[0];
  const domainMax =
    mode === "normal" ? props.max : options?.[options.length - 1];

  if (
    domainMin === undefined ||
    domainMax === undefined ||
    !Number.isFinite(domainMin) ||
    !Number.isFinite(domainMax) ||
    domainMin >= domainMax ||
    (mode === "fixed" &&
      (options.length < 2 || options.some((value) => !Number.isFinite(value))))
  ) {
    throw new RangeError("Range requires an increasing, finite domain.");
  }

  const startingValues: RangeValues = initialValues ?? [domainMin, domainMax];
  if (
    startingValues[0] < domainMin ||
    startingValues[1] > domainMax ||
    startingValues[0] > startingValues[1] ||
    (mode === "fixed" &&
      (!options.includes(startingValues[0]) ||
        !options.includes(startingValues[1])))
  ) {
    throw new RangeError("Initial range values must be valid for the domain.");
  }

  const [selected, setSelected] = useState<RangeValues>(startingValues);
  const [activeSide, setActiveSide] = useState<RangeSide | null>(null);
  const [editingSide, setEditingSide] = useState<RangeSide | null>(null);
  const [draft, setDraft] = useState("");
  const [validationError, setValidationError] = useState("");
  const trackRef = useRef<HTMLDivElement>(null);
  const dragSideRef = useRef<RangeSide | null>(null);

  const valueFromPointer = useCallback(
    (clientX: number, side: RangeSide, current: RangeValues) => {
      const bounds = trackRef.current?.getBoundingClientRect();
      if (!bounds || bounds.width === 0) return current[side === "minimum" ? 0 : 1];

      const fraction = Math.min(1, Math.max(0, (clientX - bounds.left) / bounds.width));
      const rawValue = domainMin + fraction * (domainMax - domainMin);
      const candidate =
        mode === "fixed"
          ? options.reduce((nearest, value) =>
              Math.abs(value - rawValue) < Math.abs(nearest - rawValue)
                ? value
                : nearest,
            options[0])
          : Number(rawValue.toFixed(2));

      return side === "minimum"
        ? Math.max(domainMin, Math.min(current[1], candidate))
        : Math.min(domainMax, Math.max(current[0], candidate));
    },
    [domainMax, domainMin, mode, options],
  );

  const updateFromPointer = useCallback(
    (clientX: number, side: RangeSide) => {
      setSelected((current) => {
        const next = [...current] as RangeValues;
        next[side === "minimum" ? 0 : 1] = valueFromPointer(
          clientX,
          side,
          current,
        );
        return next;
      });
    },
    [valueFromPointer],
  );

  const beginDrag = (side: RangeSide, event: PointerEvent<HTMLElement>) => {
    event.preventDefault();
    dragSideRef.current = side;
    setActiveSide(side);
    updateFromPointer(event.clientX, side);
  };

  useEffect(() => {
    if (!activeSide) return;

    const documentElement = document.documentElement;
    documentElement.classList.add("range-dragging");

    const handlePointerMove = (event: globalThis.PointerEvent) => {
      const side = dragSideRef.current;
      if (side) updateFromPointer(event.clientX, side);
    };
    const finishDragging = () => {
      dragSideRef.current = null;
      setActiveSide(null);
    };

    window.addEventListener("pointermove", handlePointerMove);
    window.addEventListener("pointerup", finishDragging);
    window.addEventListener("pointercancel", finishDragging);
    return () => {
      window.removeEventListener("pointermove", handlePointerMove);
      window.removeEventListener("pointerup", finishDragging);
      window.removeEventListener("pointercancel", finishDragging);
      documentElement.classList.remove("range-dragging");
    };
  }, [activeSide, updateFromPointer]);

  const handleTrackPointerDown = (event: PointerEvent<HTMLDivElement>) => {
    const bounds = trackRef.current?.getBoundingClientRect();
    if (!bounds || bounds.width === 0) return;

    const pointerValue =
      domainMin +
      (Math.min(1, Math.max(0, (event.clientX - bounds.left) / bounds.width)) *
        (domainMax - domainMin));
    const side: RangeSide =
      Math.abs(pointerValue - selected[0]) <=
      Math.abs(pointerValue - selected[1])
        ? "minimum"
        : "maximum";
    beginDrag(side, event);
  };

  const setSideValue = (side: RangeSide, requested: number) => {
    setSelected((current) => {
      const next = [...current] as RangeValues;
      const index = side === "minimum" ? 0 : 1;
      const candidate =
        mode === "fixed"
          ? options.reduce((nearest, value) =>
              Math.abs(value - requested) < Math.abs(nearest - requested)
                ? value
                : nearest,
            options[0])
          : requested;
      next[index] =
        side === "minimum"
          ? Math.max(domainMin, Math.min(current[1], candidate))
          : Math.min(domainMax, Math.max(current[0], candidate));
      return next;
    });
  };

  const startEditing = (side: RangeSide) => {
    setDraft(formatValue(selected[side === "minimum" ? 0 : 1]));
    setValidationError("");
    setEditingSide(side);
  };

  const commitDraft = (side: RangeSide) => {
    const value = Number(draft);
    const otherValue = selected[side === "minimum" ? 1 : 0];
    const upperBound = side === "minimum" ? otherValue : domainMax;
    const lowerBound = side === "minimum" ? domainMin : otherValue;

    if (
      draft.trim() === "" ||
      !Number.isFinite(value) ||
      value < lowerBound ||
      value > upperBound
    ) {
      setValidationError(
        `Enter a value between ${formatValue(lowerBound)} and ${formatValue(upperBound)}.`,
      );
      return;
    }

    setSideValue(side, value);
    setValidationError("");
    setEditingSide(null);
  };

  const handleKeyDown = (side: RangeSide, event: KeyboardEvent<HTMLDivElement>) => {
    const index = side === "minimum" ? 0 : 1;
    const currentValue = selected[index];
    const lowerBound = side === "minimum" ? domainMin : selected[0];
    const upperBound = side === "minimum" ? selected[1] : domainMax;
    let target: number | undefined;

    if (event.key === "Home") target = lowerBound;
    if (event.key === "End") target = upperBound;

    if (mode === "fixed") {
      const available = options.filter(
        (value) => value >= lowerBound && value <= upperBound,
      );
      const currentIndex = available.indexOf(currentValue);
      if (event.key === "ArrowRight" || event.key === "ArrowUp") {
        target = available[Math.min(available.length - 1, currentIndex + 1)];
      } else if (event.key === "ArrowLeft" || event.key === "ArrowDown") {
        target = available[Math.max(0, currentIndex - 1)];
      }
    } else {
      const step = event.shiftKey ? 10 : 1;
      if (event.key === "ArrowRight" || event.key === "ArrowUp") {
        target = Math.min(upperBound, currentValue + step);
      } else if (event.key === "ArrowLeft" || event.key === "ArrowDown") {
        target = Math.max(lowerBound, currentValue - step);
      }
    }

    if (target !== undefined) {
      event.preventDefault();
      setSideValue(side, target);
    }
  };

  const getPosition = (value: number) =>
    `${((value - domainMin) / (domainMax - domainMin)) * 100}%`;

  const renderValue = (side: RangeSide) => {
    const index = side === "minimum" ? 0 : 1;
    const value = selected[index];

    if (mode === "fixed") {
      return (
        <div className="flex flex-col gap-1">
          <span className="text-xs font-medium uppercase tracking-[0.14em] text-slate-500">
            {side}
          </span>
          <output
            aria-label={`${side === "minimum" ? "Minimum" : "Maximum"} value`}
            className="text-xl font-semibold tabular-nums text-slate-900"
          >
            {formatValue(value)}
          </output>
        </div>
      );
    }

    if (editingSide === side) {
      const errorId = `${side}-value-error`;
      return (
        <div className="flex min-w-32 flex-col gap-1">
          <label
            className="text-xs font-medium uppercase tracking-[0.14em] text-slate-500"
            htmlFor={`${side}-value-input`}
          >
            {side}
          </label>
          <input
            autoFocus
            id={`${side}-value-input`}
            aria-label={`${side === "minimum" ? "Minimum" : "Maximum"} value`}
            aria-invalid={Boolean(validationError)}
            aria-describedby={validationError ? errorId : undefined}
            className="w-32 rounded-lg border border-indigo-300 bg-white px-3 py-2 text-lg font-semibold tabular-nums text-slate-900 outline-none ring-2 ring-indigo-100 focus:border-indigo-500"
            type="number"
            min={side === "minimum" ? domainMin : selected[0]}
            max={side === "minimum" ? selected[1] : domainMax}
            step="any"
            value={draft}
            onChange={(event) => {
              setDraft(event.target.value);
              setValidationError("");
            }}
            onBlur={() => commitDraft(side)}
            onKeyDown={(event) => {
              if (event.key === "Enter") {
                event.preventDefault();
                commitDraft(side);
              } else if (event.key === "Escape") {
                setValidationError("");
                setEditingSide(null);
              }
            }}
          />
          {validationError && (
            <span
              className="max-w-48 text-xs text-rose-600"
              id={errorId}
              role="alert"
            >
              {validationError}
            </span>
          )}
        </div>
      );
    }

    return (
      <div className="flex flex-col gap-1">
        <span className="text-xs font-medium uppercase tracking-[0.14em] text-slate-500">
          {side}
        </span>
        <button
          aria-label={`Edit ${side} value`}
          className="w-fit rounded-md text-left text-xl font-semibold tabular-nums text-slate-900 underline decoration-slate-300 decoration-dotted underline-offset-4 transition hover:text-indigo-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
          type="button"
          onClick={() => startEditing(side)}
        >
          {formatValue(value)}
        </button>
      </div>
    );
  };

  const renderHandle = (side: RangeSide) => {
    const index = side === "minimum" ? 0 : 1;
    const value = selected[index];
    const active = activeSide === side;
    const title = side === "minimum" ? "Minimum value" : "Maximum value";

    return (
      <div
        key={side}
        role="slider"
        aria-label={title}
        aria-orientation="horizontal"
        aria-valuemin={side === "minimum" ? domainMin : selected[0]}
        aria-valuemax={side === "minimum" ? selected[1] : domainMax}
        aria-valuenow={value}
        aria-valuetext={formatValue(value)}
        tabIndex={0}
        className={`absolute top-1/2 z-10 flex size-7 -translate-x-1/2 -translate-y-1/2 cursor-grab touch-none items-center justify-center rounded-full border-[5px] border-white bg-indigo-600 shadow-[0_2px_10px_rgba(30,41,59,0.22)] outline-none transition-[width,height,box-shadow,transform] duration-150 hover:size-9 hover:shadow-[0_4px_14px_rgba(79,70,229,0.35)] focus-visible:ring-4 focus-visible:ring-indigo-200 ${
          active ? "size-9 cursor-grabbing shadow-[0_4px_14px_rgba(79,70,229,0.4)]" : ""
        }`}
        style={{ left: getPosition(value) }}
        onPointerDown={(event) => {
          event.stopPropagation();
          beginDrag(side, event);
        }}
        onKeyDown={(event) => handleKeyDown(side, event)}
      />
    );
  };

  return (
    <section aria-label={label} className="w-full">
      <div className="mb-10 flex min-h-16 items-start justify-between gap-4">
        {renderValue("minimum")}
        {renderValue("maximum")}
      </div>

      <div
        ref={trackRef}
        aria-label={`${label} track`}
        className="relative h-10 touch-none cursor-pointer"
        onPointerDown={handleTrackPointerDown}
      >
        <div className="absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 rounded-full bg-slate-200" />
        <div
          className="absolute top-1/2 h-1 -translate-y-1/2 rounded-full bg-indigo-600"
          style={{
            left: getPosition(selected[0]),
            right: `${100 - (selected[1] - domainMin) / (domainMax - domainMin) * 100}%`,
          }}
        />
        {renderHandle("minimum")}
        {renderHandle("maximum")}
      </div>

      <div className="mt-2 flex justify-between text-xs font-medium tabular-nums text-slate-400">
        <span>{formatValue(domainMin)}</span>
        <span>{formatValue(domainMax)}</span>
      </div>
    </section>
  );
}
</file>

